{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && (data.child('guestUid').val() === null || auth.uid === data.child('hostUid').val() || auth.uid === data.child('guestUid').val())",
        ".write": "auth != null && !data.exists() && newData.child('hostUid').val() === auth.uid",
        "guestUid": {
          ".write": "auth != null && auth.uid === newData.val() && !data.exists()"
        },
        "status": {
          ".write": "auth != null && auth.uid === root.child('rooms').child($room).child('hostUid').val()"
        },
        "feedback": {
          ".write": "auth != null && auth.uid === root.child('rooms').child($room).child('hostUid').val()"
        },
        "guessRequest": {
          ".write": "auth != null && (auth.uid === root.child('rooms').child($room).child('guestUid').val() || auth.uid === root.child('rooms').child($room).child('hostUid').val())"
        }
      }
    },
    "privateSecrets": {
      "$room": {
        ".read": "auth != null && auth.uid === root.child('rooms').child($room).child('hostUid').val()",
        ".write": "auth != null && auth.uid === root.child('rooms').child($room).child('hostUid').val()"
      }
    }
  }
}
